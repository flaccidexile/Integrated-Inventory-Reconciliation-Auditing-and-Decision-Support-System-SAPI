{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.figma.config.ts",
    "dev": "vite --host 0.0.0.0 --config vite.figma.config.ts",
    "preview": "vite preview --config vite.figma.config.ts",
    "typecheck": "tsc --noEmit",
    "verify:sql": "node tools/verify_sql.mjs",
    "check:sql": "python tools/check_sql.py",
    "check:idempotent": "python tools/audit_idempotency.py",
    "db:probe": "node tools/db_probe.mjs",
    "db:apply": "node tools/apply_schema.mjs",
    "db:check": "node tools/apply_schema.mjs --check",
    "format": "oxfmt",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:provision": "npm --prefix server run provision",
    "server:seed": "npm --prefix server run seed:sql",
    "server:setup": "npm --prefix server run setup:sql",
    "server:typecheck": "npm --prefix server run typecheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "recharts": "2.15.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "oxfmt": "^0.2.0",
    "pg": "^8.23.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^5.7.0",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-win32-x64-msvc": "4.64.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
