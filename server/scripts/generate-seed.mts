/**
 * Renders the seed dataset to `supabase/seed.sql`.
 *
 *   npm run seed:sql
 *
 * This is the path to use when you only have the Supabase SQL Editor (no direct
 * database connection). Paste the generated file into the editor and run it.
 * The dataset itself comes from `seed-rows.mts`, which the direct-push script
 * also uses.
 */

import { mkdirSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { buildSeed, seedCounts, type SeedRow } from "./seed-rows.mts";
import { USERS } from "../../src/app/data/users";
import { AS_OF_LABEL } from "../../src/app/data/company";

const HERE = dirname(fileURLToPath(import.meta.url));
const OUT = resolve(HERE, "../../supabase/seed.sql");

/* ── SQL literal rendering ─────────────────────────────────────────────── */

function literal(value: unknown): string {
  if (value === null || value === undefined) return "null";
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") {
    if (!Number.isFinite(value)) throw new Error(`Non-finite number in seed: ${value}`);
    return String(value);
  }
  return `'${String(value).replace(/'/g, "''")}'`;
}

function chunk<T>(rows: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < rows.length; i += size) out.push(rows.slice(i, i + size));
  return out;
}

function renderInsert(
  table: string,
  columns: string[],
  rows: SeedRow[],
  conflict: string,
  upsert: boolean,
): string {
  if (rows.length === 0) return `-- ${table}: nothing to insert\n`;

  const head = `insert into public.${table} (${columns.join(", ")}) values`;
  const tail = upsert
    ? `\non conflict ${conflict} do update set ${columns
        .filter((c) => c !== "id")
        .map((c) => `${c} = excluded.${c}`)
        .join(", ")};`
    : `\non conflict ${conflict} do nothing;`;

  const blocks = chunk(rows, 120).map(
    (batch) =>
      `${head}\n  ${batch
        .map((row) => `(${columns.map((c) => literal(row[c])).join(", ")})`)
        .join(",\n  ")}${tail}`,
  );

  return `-- ${table}: ${rows.length} row(s)\n${blocks.join("\n\n")}\n`;
}

/* ── Build the file ────────────────────────────────────────────────────── */

const tables = buildSeed();
const counts = seedCounts(tables);

const sections = tables.map((t) => {
  const banner = `-- ── ${t.table} ${"─".repeat(Math.max(0, 74 - t.table.length))}`;
  return `${banner}\n${renderInsert(t.table, t.columns, t.rows, t.conflict, t.upsert)}`;
});

const header = `-- ============================================================================
--  SAPI — seed data
--  Generated by server/scripts/generate-seed.mts — do not edit by hand.
--  Dataset "as of" ${AS_OF_LABEL}. Re-run \`npm run seed:sql\` after changing
--  anything under src/app/data/.
--
--  Run the migrations first:
--      0001_schema.sql -> 0002_rls.sql -> 0003_analytics.sql -> 0004_matchmaker.sql
--
--  This script runs as the postgres role, so Row Level Security is bypassed.
--  It is safe to run more than once: reference tables are upserted, while
--  transactional rows (stock, tickets, transfers, cycle tasks) are only
--  inserted when absent, so a clerk's in-progress work is never clobbered.
-- ============================================================================

begin;
`;

const footer = `-- ─────────────────────────────────────────────────────────────────────────────
--  Auth users are NOT created here.
--
--  Supabase Auth owns \`auth.users\`, and inserting into it from SQL is brittle.
--  Create the accounts through the Admin API instead — from the server folder:
--
--      npm run provision
--
--  That script creates one auth user per row below, with the matching role and
--  branch metadata, which the \`on_auth_user_created\` trigger mirrors into
--  public.profiles. The three accounts you sign in with are:
--
--      manager@southwind.com.ph      management   (BR-QC)
--      warehouse@southwind.com.ph    warehouse    (BR-QC)
--      sales@southwind.com.ph        sales        (BR-QC)
--
--  The full roster the provisioner will create:
${USERS.map((u) => `--      ${u.email.padEnd(34)} ${u.role.padEnd(10)} (${u.branchId})`).join("\n")}
-- ─────────────────────────────────────────────────────────────────────────────

commit;

-- Self-check: these should match the counts the generator reported.
select 'branches' as table_name, count(*) from public.branches
union all select 'parts', count(*) from public.parts
union all select 'suppliers', count(*) from public.suppliers
union all select 'company_settings', count(*) from public.company_settings
union all select 'stock_records', count(*) from public.stock_records
union all select 'discrepancies', count(*) from public.discrepancies
union all select 'transfers', count(*) from public.transfers
union all select 'purchase_orders', count(*) from public.purchase_orders
union all select 'cycle_tasks', count(*) from public.cycle_tasks
order by table_name;
`;

const sql = [header, ...sections, footer].join("\n");

mkdirSync(dirname(OUT), { recursive: true });
writeFileSync(OUT, sql, "utf8");

console.log(`Wrote ${OUT}`);
for (const [table, count] of Object.entries(counts)) {
  console.log(`  ${table.padEnd(20)} ${count}`);
}
console.log(`  ${"size".padEnd(20)} ${(Buffer.byteLength(sql) / 1024).toFixed(1)} kB`);
