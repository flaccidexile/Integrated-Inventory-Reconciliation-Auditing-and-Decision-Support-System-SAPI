/**
 * Builds `supabase/setup-all.sql` — every migration plus the seed, in the one
 * order that works, as a single script you can paste into the Supabase SQL
 * Editor in one go.
 *
 *   npm run setup:sql
 *
 * Why this exists: the seed inserts into tables the migrations create, so
 * running the seed first fails with `42P01: relation "public.branches" does not
 * exist`. Concatenating them removes the ordering mistake entirely.
 *
 * The whole script runs inside a single transaction, so a failure anywhere
 * rolls the database back to its previous state rather than leaving it
 * half-migrated. That is safe here because none of these files use
 * `create index concurrently`, which is the one common statement that cannot
 * run inside a transaction.
 *
 * Requires: `supabase/seed.sql` to already exist (run `npm run seed:sql` first).
 */

import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const supabaseDir = resolve(here, "../../supabase");

/** The order matters — later files depend on earlier ones. */
const SECTIONS = [
  { label: "0001_schema.sql — enums, tables, generated columns, triggers", file: "migrations/0001_schema.sql" },
  { label: "0002_rls.sql — helper functions, escalation guard, RLS policies", file: "migrations/0002_rls.sql" },
  { label: "0003_analytics.sql — security_invoker views and RPC functions", file: "migrations/0003_analytics.sql" },
  { label: "0004_matchmaker.sql — suggestion dismissal ledger", file: "migrations/0004_matchmaker.sql" },
  { label: "seed.sql — branches, parts, suppliers, stock, tickets, transfers", file: "seed.sql" },
];

/**
 * Drops standalone transaction-control lines.
 *
 * The seed file manages its own transaction, which would nest inside the outer
 * one and emit "there is already a transaction in progress" warnings. The outer
 * transaction supersedes it.
 */
function stripTransactionControl(sql: string): string {
  // Strip transaction control and any trailing standalone seed self-check,
  // since the master script provides its own unified self-check at the end.
  const cleaned = sql
    .replace(/-- Self-check: these should match the counts the generator reported\.[\s\S]*$/, "")
    .trimEnd();

  return cleaned
    .split(/\r?\n/)
    .filter((line) => !/^\s*(begin|commit|rollback)\s*;\s*$/i.test(line))
    .join("\n");
}

function banner(text: string): string {
  const line = "-- " + "=".repeat(74);
  return `${line}\n--  ${text}\n${line}\n`;
}

const parts: string[] = [];
const contents: { label: string; chars: number }[] = [];

for (const section of SECTIONS) {
  const path = join(supabaseDir, section.file);
  if (!existsSync(path)) {
    console.error(
      `\n  Missing ${section.file}.\n` +
        (section.file === "seed.sql"
          ? "  Run `npm run seed:sql` to generate it first.\n"
          : "  The migrations should be checked in — restore the file and retry.\n"),
    );
    process.exit(1);
  }

  const raw = readFileSync(path, "utf8");
  const sql = stripTransactionControl(raw).trim();

  parts.push(banner(section.label) + "\n" + sql + "\n");
  contents.push({ label: section.label, chars: sql.length });
}

const header = [
  "-- " + "=".repeat(74),
  "--  SAPI — complete database setup",
  "--  GENERATED by server/scripts/build-setup.mts — do not edit by hand.",
  "--",
  "--  HOW TO USE",
  "--    1. Supabase Dashboard -> SQL Editor -> New query",
  "--    2. Paste this entire file",
  "--    3. Run it",
  "--",
  "--  Everything runs inside one transaction: if any statement fails, the",
  "--  database rolls back to its previous state and nothing is left half-built.",
  "--",
  "--  Safe to re-run. Reference tables are upserted; transactional rows are",
  "--  only inserted when absent, so in-progress work is never clobbered.",
  "--",
  "--  Regenerate after changing anything under src/app/data/:",
  "--      cd server && npm run seed:sql && npm run setup:sql",
  "-- " + "=".repeat(74),
  "",
  "begin;",
  "",
].join("\n");

const footer = ["", "commit;", "", "-- Self-check: these should match the counts below.", ""].join("\n");

const selfCheck = [
  "select 'branches' as table_name, count(*) from public.branches",
  "union all select 'parts', count(*) from public.parts",
  "union all select 'suppliers', count(*) from public.suppliers",
  "union all select 'company_settings', count(*) from public.company_settings",
  "union all select 'stock_records', count(*) from public.stock_records",
  "union all select 'discrepancies', count(*) from public.discrepancies",
  "union all select 'transfers', count(*) from public.transfers",
  "union all select 'purchase_orders', count(*) from public.purchase_orders",
  "union all select 'cycle_tasks', count(*) from public.cycle_tasks",
  "union all select 'profiles', count(*) from public.profiles",
  "order by table_name;",
  "",
].join("\n");

const output = header + parts.join("\n") + footer + selfCheck;
const outPath = join(supabaseDir, "setup-all.sql");
writeFileSync(outPath, output, "utf8");

console.log("\n  Built supabase/setup-all.sql\n");
for (const { label, chars } of contents) {
  console.log(`    ${String(chars).padStart(6)} chars  ${label}`);
}
console.log(`\n    ${output.length} chars total -> ${outPath}\n`);
